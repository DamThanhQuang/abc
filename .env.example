# ─── Database ─────────────────────────────────────────────────────────────────
# Local: direct connection to your PostgreSQL instance.
# Supabase: use the Supavisor transaction pooler URL (port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fuelprecision"

# Supabase only: direct connection (port 5432) for running migrations.
# Not needed for local development with Docker.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/fuelprecision"

# ─── Admin bootstrap ─────────────────────────────────────────────────────────
# Used by `prisma db seed` to create the initial admin account.
# Both are required; the password must be at least 10 characters.
ADMIN_SEED_EMAIL="admin@fuelprecision.vn"
ADMIN_SEED_PASSWORD=""

# ─── Auth.js ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# On Vercel: set AUTH_TRUST_HOST=true instead of AUTH_URL.
AUTH_URL="http://localhost:3000"

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
# All R2 credentials are server-only — never prefix with NEXT_PUBLIC_.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Public URL for serving images (e.g., https://images.fuelprecision.vn)
R2_PUBLIC_URL=""

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Leave empty to disable email notifications — the contact form still works.
RESEND_API_KEY=""
ADMIN_EMAIL="admin@fuelprecision.vn"
EMAIL_FROM="FuelPrecision <no-reply@fuelprecision.vn>"

# ─── Analytics ────────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID — leave empty to disable.
NEXT_PUBLIC_GA_ID=""

# ─── Company info ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_PHONE="+842438567890"
NEXT_PUBLIC_PHONE_DISPLAY="+84 24 3856 7890"
NEXT_PUBLIC_ZALO_ID="842438567890"
NEXT_PUBLIC_CONTACT_EMAIL="contact@fuelprecision.vn"

# ─── Site URL ─────────────────────────────────────────────────────────────────
# Required in production. Used for canonical URLs, OG tags, sitemaps, JSON-LD.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
