# ─── Database ─────────────────────────────────────────────────────────────────
# Local: direct connection to your PostgreSQL instance.
# Supabase: use the Supavisor transaction pooler URL (port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=verify-full"

# Supabase only: direct or session pooler connection (port 5432) for migrations.
# Session pooler supports IPv4; direct db.PROJECT.supabase.co may require IPv6.
# Not needed for local development with Docker.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&sslaccept=strict"

# Download the CA from Supabase > Database Settings > SSL Configuration.
# Paste the complete PEM certificate; literal \n or actual newlines are accepted.
# Required when the Supabase certificate is not trusted by Node's default CA set.
DATABASE_SSL_CA=""

# ─── Admin bootstrap ─────────────────────────────────────────────────────────
# Used by `prisma db seed` to create the initial admin account.
# Both are required; the password must be at least 10 characters.
ADMIN_SEED_EMAIL="admin@astc.com.vn"
ADMIN_SEED_PASSWORD=""

# ─── Auth.js ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Local development only. Vercel infers its deployment URL automatically.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ─── Distributed rate limiting ──────────────────────────────────────────────
# Required in production for login, contact and upload protection.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
# All R2 credentials are server-only — never prefix with NEXT_PUBLIC_.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Production custom domain for serving images (e.g., https://images.astc.com.vn).
# Do not use the development-only r2.dev address in production.
R2_PUBLIC_URL=""

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Leave empty to disable email notifications — the contact form still works.
RESEND_API_KEY=""
ADMIN_EMAIL="admin@astc.com.vn"
EMAIL_FROM="Ánh Sáng Toàn Cầu <no-reply@astc.com.vn>"

# ─── Company info ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_PHONE_DISPLAY="0858.786.786"
NEXT_PUBLIC_ZALO_ID="0858786786"

# ─── Site URL ─────────────────────────────────────────────────────────────────
# Required in production. Used for canonical URLs, OG tags, sitemaps, JSON-LD.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
